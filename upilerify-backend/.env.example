# ─── UPIlerify Backend Configuration ───────────────────────────────────

# Port to bind (Render automatically sets this in production)
PORT=3001

# Public URL of this UPIlerify service (e.g. https://upilerify-backend.onrender.com)
SERVICE_URL=http://localhost:3001

# Default UPI merchant details
DEFAULT_UPI_ID=
DEFAULT_UPI_NAME=

# Dedicated Gmail credentials for bank credit-alert IMAP listening
# Generate App Password from: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=yourbusiness@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Webhook destination on your customer-facing Next.js app (Vercel)
WEBHOOK_URL=https://yourdomain.com/api/webhooks/upilerify
WEBHOOK_SECRET=whsec_generate_a_long_random_secret_here

# Secret token required by cron-job.org to trigger GET /api/check-emails
# Pass in request header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=cronsec_generate_a_long_random_secret_here

# Persistent MongoDB Atlas URI (ensures orders & matched UTRs survive Render free tier spin-downs)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/upilerify?retryWrites=true&w=majority
