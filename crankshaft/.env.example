# ==============================================================================
# CrankShaft — Production Environment Variables Configuration Template
# ==============================================================================

# MongoDB Connection String (Atlas or Self-Hosted)
# Example: mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/crankshaft?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/crankshaft?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a secure random 64-char string for production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Canonical App URL (Your live deployed production domain)
# Example: https://crankshaft.vercel.app or https://crankshaft.in
APP_URL=https://your-domain.com

# UPI & Payment Gateway Configuration (UPIlerify or Direct Intent)
UPI_ID=your_upi_vpa@upi
UPI_PAYEE_NAME=CrankShaft
UPILERIFY_URL=http://localhost:3001
UPILERIFY_WEBHOOK_SECRET=whsec_your_webhook_secret_key_here

# Firebase Client SDK Configuration (Required for Google Auth & Analytics)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=crankshaft-2c927.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=crankshaft-2c927
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=crankshaft-2c927.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=313494089497
NEXT_PUBLIC_FIREBASE_APP_ID=1:313494089497:web:515ea14b76c56c44d99f88
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-398VYD1H7D
